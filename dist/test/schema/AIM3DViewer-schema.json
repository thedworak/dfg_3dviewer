{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewer.thedworak.com/schema/AIM3DViewer-schema.json",
  "title": "AIM3DViewer Manifest",
  "type": "object",
  "required": ["@context", "id", "type", "items"],
  "properties": {
    "@context": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": ["string", "object"] } }
      ]
    },
    "id": { "type": "string" },
    "type": { "type": "string", "const": "Manifest" },
    "label": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "items": { "type": "array" },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "AIM3DViewer": {
                        "type": "object",
                        "properties": {
                          "certainty": { "$ref": "#/$defs/certaintyAssessment" }
                        },
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "AIM3DViewer": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "camera": {
          "type": "object",
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "target": { "$ref": "#/$defs/vector3" },
            "up": { "$ref": "#/$defs/vector3" },
            "fov": { "type": "number" },
            "zoom": { "type": "number" },
            "distance": { "type": "number" },
            "perspectiveMode": { "enum": ["perspective", "orthographic"] }
          },
          "additionalProperties": true
        },
        "viewer": {
          "type": "object",
          "properties": {
            "container": { "type": "string" },
            "mailUrl": { "type": "string" },
            "mainUrl": { "type": "string" },
            "baseModulePath": { "type": "string" },
            "background": { "type": "string" },
            "credits": { "type": "object" },
            "auth": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "allowRegistration": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "manifestoForm": { "$ref": "#/$defs/panelState" },
            "metadataContainer": { "$ref": "#/$defs/panelState" },
            "baseNamespace": { "type": "string" },
            "metadataUrl": { "type": "string" },
            "theme": { "enum": ["light", "dark"] },
            "language": { "enum": ["en", "pl", "de"] },
            "backgroundColor": { "type": "string" },
            "environmentMap": {
              "type": "object",
              "properties": {
                "intensity": { "type": "number" },
                "preset": { "type": "string" },
                "enabled": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "rendering": {
              "type": "object",
              "properties": {
                "toneMapping": { "enum": ["none", "linear", "reinhard", "cineon", "aces", "agx", "neutral"] },
                "exposure": { "type": "number", "minimum": 0 },
                "postprocessing": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "antialias": { "enum": ["msaa", "smaa", "fxaa", "none"] },
                    "ao": { "type": "boolean" },
                    "aoIntensity": { "type": "number", "minimum": 0, "maximum": 2 }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "lightweight": { "type": "boolean" },
            "editor": { "type": "boolean" },
            "presentationMode": { "type": "boolean" },
            "sandbox": { "type": "boolean" },
            "forceLocalPreview": { "type": "boolean" },
            "autorotate": { "type": "boolean" },
            "autorotateSpeed": { "type": "number" },
            "disableInteraction": { "type": "boolean" },
            "hideUi": { "type": "boolean" },
            "hideMetadata": { "type": "boolean" },
            "showNotifications": { "type": "boolean" },
            "scale": { "$ref": "#/$defs/vector2orObject" },
            "window": {
              "type": "object",
              "properties": {
                "position": { "$ref": "#/$defs/vector2orObject" },
                "size": {
                  "type": "object",
                  "properties": {
                    "width": { "type": "number", "minimum": 0 },
                    "height": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "performance": { "type": "string" },
            "units": { "type": ["number", "string"] },
            "gallery": { "type": "object" },
            "editorToolbar": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "position": { "$ref": "#/$defs/vector2orObject" },
                "expanded": { "type": "boolean" },
                "visible": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "menuToolbar": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "position": { "$ref": "#/$defs/vector2orObject" }
              },
              "additionalProperties": true
            },
            "clipping": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "boolean" },
                    "y": { "type": "boolean" },
                    "z": { "type": "boolean" }
                  },
                  "additionalProperties": true
                },
                "constants": { "$ref": "#/$defs/vector3" },
                "outlineVisible": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "integration": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "exportViewerUrl": { "type": "string" },
            "api": {
              "type": "object",
              "properties": {
                "thumbnailUploadEndpoint": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "position": { "$ref": "#/$defs/vector3" },
              "target": { "$ref": "#/$defs/vector3" },
              "color": { "type": "string" },
              "intensity": { "type": "number" }
            },
            "additionalProperties": true
          }
        },
        "certainty": { "$ref": "#/$defs/certaintyScale" },
        "rakingLight": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "direction": { "type": "number", "minimum": 0, "maximum": 360 },
            "height": { "type": "number", "minimum": 1, "maximum": 89 },
            "sweep": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "timeline": { "$ref": "#/$defs/timeline" },
        "modelTransform": {
          "type": "object",
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" },
                "order": { "type": "string" }
              },
              "additionalProperties": true
            },
            "scale": { "$ref": "#/$defs/vector3" },
            "wireframe": { "type": "boolean" },
            "shadingMode": {
              "type": "string",
              "enum": ["original", "standard", "phong", "lambert", "toon", "flat", "clay", "matcap", "normals", "custom"]
            },
            "customShader": {
              "type": "object",
              "properties": {
                "vertexShader": { "type": "string" },
                "fragmentShader": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "clipping": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "object",
              "properties": {
                "x": { "type": "boolean" },
                "y": { "type": "boolean" },
                "z": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "constants": { "$ref": "#/$defs/vector3" },
            "outlineVisible": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "modified": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "languageMap": {
      "description": "A IIIF language map ({\"pl\": [\"...\"]}) or a plain string.",
      "anyOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      ]
    },
    "certaintyScale": {
      "description": "Level of Certainty (LoC) scale. Levels are told apart by colour, code and symbol. A level's value is its lower bound: an assessment belongs to the highest level not above it.",
      "type": "object",
      "required": ["levels"],
      "properties": {
        "label": { "$ref": "#/$defs/languageMap" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unassessedColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "visible": { "type": "boolean", "description": "Open the manifest in the LoC view." },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opacity of the colour overlays (default 0.4)." },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "code", "color"],
            "properties": {
              "value": { "type": "number" },
              "code": { "type": "string", "minLength": 1, "description": "Short code, e.g. a letter (A-E)." },
              "symbol": { "type": "string", "description": "Shown with the code, e.g. ✓ or ?." },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "label": { "$ref": "#/$defs/languageMap" },
              "description": { "$ref": "#/$defs/languageMap" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "description": "4D timeline: the model's stages in time. Any year can be shown; the stages around it are faded into each other. Stages come from the model (glTF scene extras `timeline`, or node extras `year`) unless listed here.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "false: the model's own timeline is not used (default true)." },
        "showPanel": { "type": "boolean", "description": "Show the timeline panel (default true). Without it the model stays at `year`." },
        "year": { "type": "number", "description": "Year shown when the manifest opens (default startYear)." },
        "startYear": { "type": "number" },
        "endYear": { "type": "number" },
        "label": { "$ref": "#/$defs/languageMap" },
        "description": { "$ref": "#/$defs/languageMap" },
        "transition": { "enum": ["interpolate", "step"], "description": "interpolate: a year between two stages blends them (default); step: the last stage reached is shown, faded in over transitionDuration." },
        "transitionDuration": { "type": "number", "minimum": 0, "description": "Seconds a jump to another year (or a step fade) takes (default 0.8)." },
        "playback": {
          "type": "object",
          "properties": {
            "autoplay": { "type": "boolean" },
            "loop": { "type": "boolean" },
            "yearsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "speed": { "type": "number", "exclusiveMinimum": 0, "description": "Multiple of yearsPerSecond chosen in the panel (default 1)." },
            "pauseAtEvents": { "type": "number", "minimum": 0, "description": "Seconds held on each documented stage while playing (default 1.5)." }
          },
          "additionalProperties": true
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year"],
            "properties": {
              "year": { "type": "number" },
              "yearLabel": { "$ref": "#/$defs/languageMap" },
              "approximate": { "type": "boolean", "description": "The date is approximate (shown as c. 1730)." },
              "type": { "enum": ["documented", "modelled"], "description": "documented: an event from the sources; modelled: a state reconstructed between them." },
              "label": { "$ref": "#/$defs/languageMap" },
              "description": { "$ref": "#/$defs/languageMap" },
              "source": { "$ref": "#/$defs/languageMap" },
              "nodes": { "type": "array", "items": { "type": "string" }, "description": "Model nodes that show this stage. Left out: those of the model's stage of the same year." }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "certaintyAssessment": {
      "description": "Level of Certainty of the object (or group) an annotation targets.",
      "type": "object",
      "anyOf": [{ "required": ["value"] }, { "required": ["code"] }],
      "properties": {
        "value": { "type": "number" },
        "code": { "type": "string" },
        "scope": { "enum": ["object", "group"] },
        "targetId": { "type": "string", "description": "The object painted: the annotated object, or its parent for scope \"group\"." }
      },
      "additionalProperties": true
    },
    "vector3": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 3,
          "items": { "type": "number" }
        },
        {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          },
          "additionalProperties": true
        }
      ]
    },
    "panelState": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vector2orObject" },
        "size": {
          "type": "object",
          "properties": {
            "width": { "type": ["number", "null"], "minimum": 0 },
            "height": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "vector2orObject": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 2,
          "items": { "type": "number" }
        },
        {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}