{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explora4d.eu/viewer/schema/AIM3DViewer-schema.json",
  "title": "AIM3DViewer Manifest",
  "type": "object",
  "required": ["@context", "id", "type", "items"],
  "properties": {
    "@context": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": ["string", "object"] } }
      ]
    },
    "id": { "type": "string" },
    "type": { "type": "string", "const": "Manifest" },
    "label": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "items": { "type": "array" },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "AIM3DViewer": {
                        "type": "object",
                        "properties": {
                          "certainty": { "$ref": "#/$defs/certaintyAssessment" }
                        },
                        "additionalProperties": true
                      }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "AIM3DViewer": {
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "generatedAt": { "type": "string" },
        "camera": {
          "type": "object",
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "target": { "$ref": "#/$defs/vector3" },
            "up": { "$ref": "#/$defs/vector3" },
            "fov": { "type": "number" },
            "zoom": { "type": "number" },
            "distance": { "type": "number" },
            "perspectiveMode": { "enum": ["perspective", "orthographic"] }
          },
          "additionalProperties": true
        },
        "viewer": {
          "type": "object",
          "properties": {
            "container": { "type": "string" },
            "mailUrl": { "type": "string" },
            "mainUrl": { "type": "string" },
            "baseModulePath": { "type": "string" },
            "background": { "type": "string" },
            "credits": { "type": "object" },
            "auth": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "allowRegistration": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "manifestoForm": { "$ref": "#/$defs/panelState" },
            "metadataContainer": { "$ref": "#/$defs/panelState" },
            "baseNamespace": { "type": "string" },
            "metadataUrl": { "type": "string" },
            "theme": { "enum": ["light", "dark"] },
            "language": { "enum": ["en", "pl", "de"] },
            "backgroundColor": { "type": "string" },
            "environmentMap": {
              "type": "object",
              "properties": {
                "intensity": { "type": "number" },
                "preset": { "type": "string" },
                "enabled": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "rendering": {
              "type": "object",
              "properties": {
                "toneMapping": { "enum": ["none", "linear", "reinhard", "cineon", "aces", "agx", "neutral"] },
                "exposure": { "type": "number", "minimum": 0 },
                "postprocessing": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "antialias": { "enum": ["msaa", "smaa", "fxaa", "none"] },
                    "ao": { "type": "boolean" },
                    "aoIntensity": { "type": "number", "minimum": 0, "maximum": 2 }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "lightweight": { "type": "boolean" },
            "editor": { "type": "boolean" },
            "presentationMode": { "type": "boolean" },
            "sandbox": { "type": "boolean" },
            "forceLocalPreview": { "type": "boolean" },
            "autorotate": { "type": "boolean" },
            "autorotateSpeed": { "type": "number" },
            "disableInteraction": { "type": "boolean" },
            "hideUi": { "type": "boolean" },
            "hideMetadata": { "type": "boolean" },
            "showNotifications": { "type": "boolean" },
            "scale": { "$ref": "#/$defs/vector2orObject" },
            "window": {
              "type": "object",
              "properties": {
                "position": { "$ref": "#/$defs/vector2orObject" },
                "size": {
                  "type": "object",
                  "properties": {
                    "width": { "type": "number", "minimum": 0 },
                    "height": { "type": "number", "minimum": 0 }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "performance": { "type": "string" },
            "units": { "type": ["number", "string"] },
            "gallery": { "type": "object" },
            "editorToolbar": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "position": { "$ref": "#/$defs/vector2orObject" },
                "expanded": { "type": "boolean" },
                "visible": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "menuToolbar": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "position": { "$ref": "#/$defs/vector2orObject" }
              },
              "additionalProperties": true
            },
            "clipping": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "boolean" },
                    "y": { "type": "boolean" },
                    "z": { "type": "boolean" }
                  },
                  "additionalProperties": true
                },
                "constants": { "$ref": "#/$defs/vector3" },
                "outlineVisible": { "type": "boolean" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "integration": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "exportViewerUrl": { "type": "string" },
            "api": {
              "type": "object",
              "properties": {
                "thumbnailUploadEndpoint": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "position": { "$ref": "#/$defs/vector3" },
              "target": { "$ref": "#/$defs/vector3" },
              "color": { "type": "string" },
              "intensity": { "type": "number" },
              "name": { "type": "string" },
              "castShadow": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "certainty": { "$ref": "#/$defs/certaintyScale" },
        "rakingLight": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "direction": { "type": "number", "minimum": 0, "maximum": 360 },
            "height": { "type": "number", "minimum": 1, "maximum": 89 },
            "sweep": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "timeline": { "$ref": "#/$defs/timeline" },
        "variants": { "$ref": "#/$defs/variants" },
        "compare": { "$ref": "#/$defs/compare" },
        "location": {
          "description": "Where the model stands on the Earth, for the sun.",
          "type": "object",
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "north": { "type": "number", "description": "Direction of north in the scene: degrees clockwise from -Z, seen from above (default 0)." },
            "utcOffset": { "type": "number", "minimum": -14, "maximum": 14, "description": "Hours the local time is ahead of UTC (default: longitude / 15, rounded)." }
          },
          "additionalProperties": true
        },
        "sun": {
          "description": "The sun at a place (AIM3DViewer.location) on a day and hour, casting shadows; exported while on.",
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "date": { "type": "string", "pattern": "^(-?\\d{1,4}-)?\\d{1,2}-\\d{1,2}$", "description": "\"MM-DD\", or \"YYYY-MM-DD\" (the year is the timeline's while followTimeline is on; default: today at the model's place)." },
            "time": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$", "description": "Local time, \"HH:MM\" (default: the time now at the model's place)." },
            "followTimeline": { "type": "boolean", "description": "Take the year from the 4D timeline (default true)." },
            "animate": { "type": "boolean", "description": "Play the day on open (default false)." }
          },
          "additionalProperties": true
        },
        "weather": {
          "description": "The weather around the model (Look > Weather); exported while on.",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["clear", "fog", "rain", "snow", "storm"] },
            "intensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0.6." },
            "wind": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0.2; a storm brings at least some." },
            "windDirection": { "type": "number", "description": "Where the wind blows to: degrees clockwise from -Z, seen from above (default 230)." },
            "mistHeight": { "type": "number", "minimum": 0, "maximum": 1, "description": "The mist's height: 0 to 1 is 0.15 to 1.15 model sizes (default 0.4)." },
            "mistDensity": { "type": "number", "minimum": 0, "maximum": 1, "description": "The mist's density (default 0.5)." },
            "mistSpread": { "type": "number", "minimum": 0, "maximum": 1, "description": "0: clumps with gaps; 1: an even blanket thinning upwards (default 0.6)." },
            "sky": { "type": "boolean", "description": "Show the sky with clouds around the model (default true)." },
            "surfaces": { "type": "boolean", "description": "Wet surfaces and snow cover on the model (default true)." }
          },
          "additionalProperties": true
        },
        "materials": {
          "description": "The model's materials as edited in the viewer (Look > Materials); exported while any is edited. The model's own materials stay as they are in its file.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": { "type": "integer", "minimum": 0, "description": "The material's place in the model (the order the viewer meets them in)." },
              "name": { "type": "string", "description": "The material's name in the file; with the index it finds the material." },
              "preset": { "enum": ["glass", "frostedGlass", "tintedGlass", "water", "lightWood", "darkWood", "varnishedWood", "plaster", "paintedWall", "concrete", "brick", "sandstone", "marble", "terracotta", "ceramic", "steel", "aluminium", "iron", "brass", "gold", "copper", "bronze", "mirror", "plastic", "rubber", "fabric", "clay", "light", null], "description": "The built-in material type applied first." },
              "keepTexture": { "type": "boolean", "description": "The type keeps the colour texture (default true)." },
              "params": {
                "type": "object",
                "description": "The properties over the type: colours as \"#rrggbb\", the rest as numbers.",
                "properties": {
                  "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "emissive": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                  "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                  "transmission": { "type": "number", "minimum": 0, "maximum": 1 },
                  "thickness": { "type": "number", "minimum": 0 },
                  "ior": { "type": "number", "minimum": 0 },
                  "clearcoat": { "type": "number", "minimum": 0, "maximum": 1 },
                  "clearcoatRoughness": { "type": "number", "minimum": 0, "maximum": 1 },
                  "sheen": { "type": "number", "minimum": 0, "maximum": 1 },
                  "emissiveIntensity": { "type": "number", "minimum": 0 },
                  "doubleSided": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "sceneSuggest": {
          "description": "The Suggested scene window (Look > Suggested scene) open when the manifest loads; nothing is applied until the user does.",
          "type": "object",
          "properties": {
            "open": { "type": "boolean", "description": "Open the window on load (default false)." },
            "purpose": { "enum": ["documentation", "presentation"], "description": "The purpose shown first (default: the one the rules pick)." }
          },
          "additionalProperties": true
        },
        "photos": {
          "description": "Historical photos laid over the model from the camera they were taken from.",
          "type": "array",
          "items": { "$ref": "#/$defs/photo" }
        },
        "thumbnails": {
          "description": "Renders of the model shown in the thumbnail gallery, in this order (any number). Without it the viewer shows its generic placeholder images. Relative URLs (\"./...\") resolve like the manifest's model URLs.",
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["src"],
                "properties": {
                  "src": { "type": "string", "minLength": 1 },
                  "label": { "$ref": "#/$defs/languageMap" }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "modelTransform": {
          "type": "object",
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "rotation": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" },
                "order": { "type": "string" }
              },
              "additionalProperties": true
            },
            "scale": { "$ref": "#/$defs/vector3" },
            "upAxis": {
              "type": "string",
              "enum": ["Y+", "Y-", "Z+", "Z-", "X+", "X-"],
              "description": "The axis of the model file that points up; the viewer turns it to +Y before applying position, rotation and scale. Y+ (default) for three.js / glTF models, Z+ for Z-up exports, Y- for a model upside down."
            },
            "wireframe": { "type": "boolean" },
            "shadingMode": {
              "type": "string",
              "enum": ["original", "standard", "phong", "lambert", "toon", "flat", "clay", "matcap", "normals", "custom"]
            },
            "customShader": {
              "type": "object",
              "properties": {
                "vertexShader": { "type": "string" },
                "fragmentShader": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "clipping": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "object",
              "properties": {
                "x": { "type": "boolean" },
                "y": { "type": "boolean" },
                "z": { "type": "boolean" }
              },
              "additionalProperties": true
            },
            "constants": { "$ref": "#/$defs/vector3" },
            "outlineVisible": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "modified": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "languageMap": {
      "description": "A IIIF language map ({\"pl\": [\"...\"]}) or a plain string.",
      "anyOf": [
        { "type": "string" },
        { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
      ]
    },
    "certaintyScale": {
      "description": "Level of Certainty (LoC) scale. Levels are told apart by colour, code and symbol. A level's value is its lower bound: an assessment belongs to the highest level not above it.",
      "type": "object",
      "required": ["levels"],
      "properties": {
        "label": { "$ref": "#/$defs/languageMap" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unassessedColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "visible": { "type": "boolean", "description": "Open the manifest in the LoC view." },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opacity of the colour overlays (default 0.4)." },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "code", "color"],
            "properties": {
              "value": { "type": "number" },
              "code": { "type": "string", "minLength": 1, "description": "Short code, e.g. a letter (A-E)." },
              "symbol": { "type": "string", "description": "Shown with the code, e.g. ✓ or ?." },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "label": { "$ref": "#/$defs/languageMap" },
              "description": { "$ref": "#/$defs/languageMap" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "timeline": {
      "description": "4D timeline: the model's stages in time. Any year can be shown; the stages around it are faded into each other. Stages come from the model (glTF scene extras `timeline`, or node extras `year`) unless listed here.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "false: the model's own timeline is not used (default true)." },
        "showPanel": { "type": "boolean", "description": "Show the timeline panel (default true). Without it the model stays at `year`." },
        "year": { "type": "number", "description": "Year shown when the manifest opens (default startYear)." },
        "startYear": { "type": "number" },
        "endYear": { "type": "number" },
        "label": { "$ref": "#/$defs/languageMap" },
        "description": { "$ref": "#/$defs/languageMap" },
        "transition": { "enum": ["interpolate", "step"], "description": "interpolate: a year between two stages blends them (default); step: the last stage reached is shown, faded in over transitionDuration." },
        "transitionDuration": { "type": "number", "minimum": 0, "description": "Seconds a jump to another year (or a step fade) takes (default 0.8)." },
        "playback": {
          "type": "object",
          "properties": {
            "autoplay": { "type": "boolean" },
            "loop": { "type": "boolean" },
            "yearsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
            "speed": { "type": "number", "exclusiveMinimum": 0, "description": "Multiple of yearsPerSecond chosen in the panel (default 0.5)." },
            "pauseAtEvents": { "type": "number", "minimum": 0, "description": "Seconds held on each documented stage while playing (default 1.5)." }
          },
          "additionalProperties": true
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year"],
            "properties": {
              "year": { "type": "number" },
              "yearLabel": { "$ref": "#/$defs/languageMap" },
              "approximate": { "type": "boolean", "description": "The date is approximate (shown as c. 1730)." },
              "type": { "enum": ["documented", "modelled"], "description": "documented: an event from the sources; modelled: a state reconstructed between them." },
              "label": { "$ref": "#/$defs/languageMap" },
              "description": { "$ref": "#/$defs/languageMap" },
              "source": { "$ref": "#/$defs/languageMap" },
              "nodes": { "type": "array", "items": { "type": "string" }, "description": "Model nodes that show this stage. Left out: those of the model's stage of the same year." }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "variants": {
      "description": "Reconstruction variants: alternative hypotheses of the same object, each a set of model nodes. One is shown at a time; nodes of no variant are always shown. Variants come from the model (glTF scene extras `variants`, or node extras `variant`) unless listed here.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "false: the model's own variants are not used (default true)." },
        "showPanel": { "type": "boolean", "description": "Show the variants panel (default true)." },
        "label": { "$ref": "#/$defs/languageMap" },
        "description": { "$ref": "#/$defs/languageMap" },
        "active": { "type": "string", "description": "Id of the variant shown (default the first)." },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "label": { "$ref": "#/$defs/languageMap" },
              "description": { "$ref": "#/$defs/languageMap" },
              "source": { "$ref": "#/$defs/languageMap" },
              "certainty": { "type": "number", "description": "Level of Certainty value on the manifest's scale (AIM3DViewer.certainty), shown as the level's badge." },
              "nodes": { "type": "array", "items": { "type": "string" }, "description": "Model nodes of this variant. Left out: those of the model's variant with the same id." }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "compareSide": {
      "type": "object",
      "anyOf": [{ "required": ["variant"] }, { "required": ["year"] }, { "required": ["shading"] }, { "required": ["lighting"] }],
      "properties": {
        "variant": { "type": "string", "description": "Id of a variant." },
        "year": { "type": "number", "description": "A year of the timeline: the last stage reached is shown." },
        "shading": { "enum": ["original", "standard", "phong", "lambert", "toon", "flat", "clay", "matcap", "normals", "custom"], "description": "A shading mode (kind \"look\")." },
        "lighting": { "enum": ["current", "noEnvironment", "neutral", "sunny", "studio", "goldenHour", "raking"], "description": "The lighting (kind \"look\"): as set, without the environment map, an environment preset, or the raking light." }
      },
      "additionalProperties": true
    },
    "compare": {
      "description": "Comparison view, open when the manifest loads: two variants or two years of the timeline, or (kind \"look\") the model shaded and lit two ways, split by a divider (swipe) or side by side (split).",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "false: no comparison on open (default true)." },
        "kind": { "enum": ["content", "look"], "description": "content: variants or years (default); look: shading and lighting." },
        "mode": { "enum": ["swipe", "split"], "description": "swipe: one view split by a divider (default); split: two halves side by side." },
        "position": { "type": "number", "minimum": 0, "maximum": 1, "description": "Divider position across the canvas in swipe mode (default 0.5)." },
        "left": { "$ref": "#/$defs/compareSide" },
        "right": { "$ref": "#/$defs/compareSide" }
      },
      "additionalProperties": true
    },
    "photo": {
      "type": "object",
      "anyOf": [{ "required": ["src"] }, { "required": ["service"] }],
      "properties": {
        "id": { "type": "string" },
        "src": { "type": "string", "description": "Image URL, or a IIIF Image API info.json." },
        "service": { "description": "A IIIF Image API service (its URL or an object with id): the image is asked for at up to 2000 px.", "anyOf": [{ "type": "string" }, { "type": "object" }] },
        "label": { "$ref": "#/$defs/languageMap" },
        "description": { "$ref": "#/$defs/languageMap" },
        "source": { "$ref": "#/$defs/languageMap" },
        "year": { "type": "number", "description": "Year the photo was taken: the 4D timeline goes there when it opens." },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Opacity of the photo over the model (default 0.6)." },
        "view": {
          "type": "object",
          "required": ["position", "target"],
          "properties": {
            "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "target": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
            "fov": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180, "description": "Vertical field of view in degrees." },
            "roll": { "type": "number", "description": "Tilt of the photo in degrees, clockwise." }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "certaintyAssessment": {
      "description": "Level of Certainty of the object (or group) an annotation targets.",
      "type": "object",
