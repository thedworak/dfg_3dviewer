#usda 1.0
(
    customLayerData = {
        string creator = "ExPlora4D - scripts/build-tempietto-examples.mjs"
    }
    defaultPrim = "Tempietto"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Tempietto" (
    kind = "component"
)
{
    def Scope "Materials"
    {
        def Material "stone"
        {
            token outputs:surface.connect = </Tempietto/Materials/stone/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Tempietto/Materials/stone/BaseColor.outputs:rgb>
                normal3f inputs:normal.connect = </Tempietto/Materials/stone/Normal.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
            def Shader "UVReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @tex/base_ao.webp@
                float2 inputs:st.connect = </Tempietto/Materials/stone/UVReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float3 outputs:rgb
            }
            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @tex/normal.webp@
                float2 inputs:st.connect = </Tempietto/Materials/stone/UVReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (2, 2, 2, 1)
                float4 inputs:bias = (-1, -1, -1, 0)
                float3 outputs:rgb
            }
        }

        def Material "glass"
        {
            token outputs:surface.connect = </Tempietto/Materials/glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.84, 0.91, 0.94)
                float inputs:metallic = 0
                float inputs:roughness = 0.05
                float inputs:ior = 1.5
                float inputs:opacity = 0.25
                token outputs:surface
            }
        }

        def Material "stained"
        {
            token outputs:surface.connect = </Tempietto/Materials/stained/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Tempietto/Materials/stained/Glass.outputs:rgb>
                float inputs:opacity.connect = </Tempietto/Materials/stained/Glass.outputs:a>
                float inputs:metallic = 0
                float inputs:roughness = 0.15
                token outputs:surface
            }
            def Shader "UVReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Glass"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @tex/glass.png@
                float2 inputs:st.connect = </Tempietto/Materials/stained/UVReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                token inputs:sourceColorSpace = "sRGB"
                float3 outputs:rgb
                float outputs:a
            }
        }
    }

