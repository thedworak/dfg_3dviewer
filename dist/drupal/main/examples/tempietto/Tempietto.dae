  <library_images><image id="base_ao-image" name="base_ao"><init_from>tex/base_ao.webp</init_from></image><image id="normal-image" name="normal"><init_from>tex/normal.webp</init_from></image><image id="glass-image" name="glass"><init_from>tex/glass.png</init_from></image></library_images>
  <library_effects>
    <effect id="stone-effect"><profile_COMMON>
        <newparam sid="base_ao-surface"><surface type="2D"><init_from>base_ao-image</init_from></surface></newparam>
        <newparam sid="base_ao-sampler"><sampler2D><source>base_ao-surface</source></sampler2D></newparam>
        <newparam sid="normal-surface"><surface type="2D"><init_from>normal-image</init_from></surface></newparam>
        <newparam sid="normal-sampler"><sampler2D><source>normal-surface</source></sampler2D></newparam>
      <technique sid="common"><phong><diffuse><texture texture="base_ao-sampler" texcoord="UVMap"/></diffuse><specular><color>0.04 0.04 0.04 1</color></specular><shininess><float>10</float></shininess></phong><extra><technique profile="FCOLLADA"><bump><texture texture="normal-sampler" texcoord="UVMap"/></bump></technique></extra></technique>
    </profile_COMMON></effect>
    <effect id="glass-effect"><profile_COMMON>
      <technique sid="common"><phong><diffuse><color>0.84 0.91 0.94 1</color></diffuse><specular><color>1 1 1 1</color></specular><shininess><float>200</float></shininess><transparent opaque="A_ONE"><color>1 1 1 0.25</color></transparent><transparency><float>1</float></transparency></phong></technique>
    </profile_COMMON></effect>
    <effect id="stained-effect"><profile_COMMON>
        <newparam sid="glass-surface"><surface type="2D"><init_from>glass-image</init_from></surface></newparam>
        <newparam sid="glass-sampler"><sampler2D><source>glass-surface</source></sampler2D></newparam>
      <technique sid="common"><phong><emission><color>0.1 0.1 0.1 1</color></emission><diffuse><texture texture="glass-sampler" texcoord="UVMap"/></diffuse><specular><color>0.2 0.2 0.2 1</color></specular><shininess><float>80</float></shininess><transparent opaque="A_ONE"><texture texture="glass-sampler" texcoord="UVMap"/></transparent><transparency><float>1</float></transparency></phong></technique>
    </profile_COMMON></effect>
  </library_effects>
  <library_materials><material id="stone-material" name="stone"><instance_effect url="#stone-effect"/></material><material id="glass-material" name="glass"><instance_effect url="#glass-effect"/></material><material id="stained-material" name="stained"><instance_effect url="#stained-effect"/></material></library_materials>
