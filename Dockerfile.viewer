# Static build of the standalone viewer (dist/test), served for local/self-hosted
# use. This does not touch how the Drupal module itself is packaged/built
# (npm run build:drupal); it only containerizes the existing "test" build,
# fronted by nginx so /api/ and /files/ can be reverse-proxied to the worker
# container (see docker/nginx.conf) - same-origin, no CORS/config needed.
#
#   docker build -f Dockerfile.viewer -t dfg-3dviewer-viewer .

FROM node:alpine AS build
WORKDIR /app
# package.json has no "packageManager" field, so Corepack has nothing to pin
# and errors out in a non-interactive build instead of guessing a version -
# install pnpm directly instead. Pinned to 12.3.4 (newer than the "^11.26.0"
# in package.json's own dependencies, which is just a version hint, not a
# pnpm-enforced constraint) - verified against this repo's lockfile locally.
# Requires Node >= 22.13, hence the unpinned "node:alpine" base below.
RUN npm install -g pnpm@12.3.4
# pnpm-workspace.yaml records this repo's build-script approval decisions
# (allowBuilds) - without it pnpm can't tell those are already decided and
# refuses to install non-interactively.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build:test

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/test /usr/share/nginx/html
EXPOSE 3000
