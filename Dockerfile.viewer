# Static build of the standalone viewer, served for local/self-hosted use.
# This does not touch how the Drupal module itself is packaged/built (npm
# run build:drupal); it only containerizes one of the existing npm build
# targets (test/dev/prod, selected via BUILD_TARGET), fronted by nginx so
# /api/ and /files/ can be reverse-proxied to the worker container (see
# docker/nginx.conf) - same-origin, no CORS/config needed.
#
# docker-compose.yml builds this three times (viewer-test, viewer-dev,
# viewer-sandbox) with different build args - see its comments and the
# "Standalone Docker setup" section in README.md. To build a single one
# manually:
#
#   docker build -f Dockerfile.viewer --build-arg BUILD_TARGET=dev \
#     --build-arg VIEWER_PROFILE=dev -t dfg-3dviewer-viewer-dev .
#
# VIEWER_PROFILE selects docker/profiles/<profile>.manifest.json (dev, test
# or sandbox): an AIM3D manifest carrying the viewer settings for that image.

ARG BUILD_TARGET=test
ARG VIEWER_PROFILE=test

FROM node:alpine AS build
ARG BUILD_TARGET
ARG VIEWER_PROFILE
# Commit short hash shown in the credits footer (.git is not in the build
# context) - set by deploy.yml / `BUILD_ID=$(git rev-parse --short HEAD)`.
ARG BUILD_ID=
ENV BUILD_ID=${BUILD_ID}
WORKDIR /app
# The pnpm version pinned in package.json ("packageManager"), the same as CI
# (.github/workflows) and local installs - keep the two in step. Installed
# directly rather than through Corepack. Requires Node >= 22.13, hence the
# unpinned "node:alpine" base below.
RUN npm install -g pnpm@12.8.1
# pnpm-workspace.yaml records this repo's build-script approval decisions
# (allowBuilds) - without it pnpm can't tell those are already decided and
# refuses to install non-interactively.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Fail the build (not the running container) if the profile manifest is
# missing or invalid.
RUN node scripts/validate-docker-profiles.mjs ${VIEWER_PROFILE}
# Optional build extension (VIEWER_BUILD_EXTENSION in rollup.config.js),
# a path inside the build context.
ARG VIEWER_BUILD_EXTENSION=
ENV VIEWER_BUILD_EXTENSION=${VIEWER_BUILD_EXTENSION}
RUN pnpm run build:${BUILD_TARGET}

FROM nginx:alpine
ARG BUILD_TARGET
ARG VIEWER_PROFILE
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/${BUILD_TARGET} /usr/share/nginx/html
# The viewer settings come from the profile's AIM3D manifest (see
# docker/profiles/): it is installed as manifests/docker-profile.json and
# viewer-settings.json is only pointed at it (metadata source AIM3IF + URL).
# viewer-settings.json stays the fallback for anything the manifest omits.
# Anyone can still add ?sandbox=1 (or similar URL options) on any service.
COPY docker/profiles/${VIEWER_PROFILE}.manifest.json /usr/share/nginx/html/manifests/docker-profile.json
RUN apk add --no-cache jq && \
    jq '.entity.metadata.sourceType = "AIM3IF" | .entity.metadata.url = "manifests/docker-profile.json"' \
        /usr/share/nginx/html/viewer-settings.json > /tmp/viewer-settings.json && \
    mv /tmp/viewer-settings.json /usr/share/nginx/html/viewer-settings.json && \
    apk del jq
# Symlinks viewer-settings.json and the profile manifest to the viewer-settings volume (see
# docker-compose.yml) on every container start - runs automatically because
# nginx:alpine's own entrypoint executes every *.sh in /docker-entrypoint.d/
# before starting nginx.
COPY docker/viewer-entrypoint.d/10-persist-viewer-settings.sh /docker-entrypoint.d/10-persist-viewer-settings.sh
RUN chmod +x /docker-entrypoint.d/10-persist-viewer-settings.sh
EXPOSE 3000
