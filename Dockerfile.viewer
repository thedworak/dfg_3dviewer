# Static build of the standalone viewer, served for local/self-hosted use.
# This does not touch how the Drupal module itself is packaged/built (npm
# run build:drupal); it only containerizes one of the existing npm build
# targets (test/dev/prod, selected via BUILD_TARGET), fronted by nginx so
# /api/ and /files/ can be reverse-proxied to the worker container (see
# docker/nginx.conf) - same-origin, no CORS/config needed.
#
# docker-compose.yml builds this three times (viewer-test, viewer-dev,
# viewer-sandbox) with different build args - see its comments and the
# "Standalone Docker setup" section in README.md. To build a single one
# manually:
#
#   docker build -f Dockerfile.viewer --build-arg BUILD_TARGET=dev -t dfg-3dviewer-viewer-dev .

ARG BUILD_TARGET=test

FROM node:alpine AS build
ARG BUILD_TARGET
WORKDIR /app
# package.json has no "packageManager" field, so Corepack has nothing to pin
# and errors out in a non-interactive build instead of guessing a version -
# install pnpm directly instead. Pinned to 12.3.4 (newer than the "^11.26.0"
# in package.json's own dependencies, which is just a version hint, not a
# pnpm-enforced constraint) - verified against this repo's lockfile locally.
# Requires Node >= 22.13, hence the unpinned "node:alpine" base below.
RUN npm install -g pnpm@12.3.4
# pnpm-workspace.yaml records this repo's build-script approval decisions
# (allowBuilds) - without it pnpm can't tell those are already decided and
# refuses to install non-interactively.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build:${BUILD_TARGET}

FROM nginx:alpine
ARG BUILD_TARGET
# "Sandbox mode" (drag-and-drop upload via ?sandbox=1, see viewer/sandbox.js)
# is a runtime viewer-settings.json flag, not a separate build - this just
# bakes viewer.sandboxMode=true into the image's default settings file so
# the sandbox service lands in that mode without needing the query param.
# Anyone can still add/remove ?sandbox=1 on any of the three services.
ARG SANDBOX_MODE=false
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/${BUILD_TARGET} /usr/share/nginx/html
RUN if [ "$SANDBOX_MODE" = "true" ]; then \
        apk add --no-cache jq && \
        jq '.viewer.sandboxMode = true' /usr/share/nginx/html/viewer-settings.json > /tmp/viewer-settings.json && \
        mv /tmp/viewer-settings.json /usr/share/nginx/html/viewer-settings.json && \
        apk del jq; \
    fi
# Symlinks viewer-settings.json to the viewer-settings volume (see
# docker-compose.yml) on every container start - runs automatically because
# nginx:alpine's own entrypoint executes every *.sh in /docker-entrypoint.d/
# before starting nginx.
COPY docker/viewer-entrypoint.d/10-persist-viewer-settings.sh /docker-entrypoint.d/10-persist-viewer-settings.sh
RUN chmod +x /docker-entrypoint.d/10-persist-viewer-settings.sh
EXPOSE 3000
