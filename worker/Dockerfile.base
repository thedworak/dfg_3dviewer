# Base image of the standalone conversion worker: Ubuntu + system packages,
# Python libraries, Blender and gltfpack - everything that changes rarely and
# takes long to install. worker/Dockerfile builds on top of it and only adds
# the repository code (scripts/, worker/*.py), so code changes rebuild in
# seconds instead of re-downloading Blender.
#
# docker-compose.yml builds it as the worker-base service (never started,
# scale: 0) before the worker; after the first build every layer comes from
# the local build cache, and editing this file rebuilds only the changed
# layers. .github/workflows/worker-base.yml publishes it to GHCR with inline
# cache metadata, which compose uses as cache_from so that fresh machines
# (e.g. CI runners) do not have to download and unpack Blender either.
#
# The build needs no files from the repository (everything is downloaded):
#   docker build -f worker/Dockerfile.base -t dfg-3dviewer-worker-base worker

# Spark's build-lod (worker/splats.py): turns uploaded Gaussian splats into
# a .rad level-of-detail file. There is no release binary; it is built from
# the Spark repository in a stage of its own, so the Rust toolchain stays out
# of the image. SPARK_VERSION must match @sparkjsdev/spark in package.json -
# the viewer's Spark reads the .rad files. Without the "gpu" feature (wgpu,
# for clustering SH coefficients): the container has no GPU.
ARG SPARK_VERSION=2.2.0
FROM rust:1.90-bookworm AS spark-build-lod
ARG SPARK_VERSION
RUN git clone --depth 1 --branch "v${SPARK_VERSION}" https://github.com/sparkjsdev/spark.git /spark \
    && cd /spark/rust \
    && cargo build --release -p build-lod --no-default-features \
    && install -m 755 target/release/build-lod /usr/local/bin/build-lod

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# System package list mirrors the "Ubuntu way" instructions already
# documented at the top of scripts/convert.py, minus the `blender` apt
# package itself: Ubuntu 24.04's build (tested: 4.0.2) turned out to be
# compiled without OpenImageDenoise, which scripts/render.py sets
# unconditionally (scene.cycles.denoiser = 'OPENIMAGEDENOISE') - that raised
# a TypeError before a single frame rendered. Using the official Blender
# release tarball below instead is exactly the "Debian way" alternative
# convert.py's own comments already suggest. libgl1-mesa-dri/libegl1 give
# Blender's EEVEE engine a software (llvmpipe) OpenGL context to render with,
# since there's no GPU in the container (see LIBGL_ALWAYS_SOFTWARE below).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        xz-utils \
        unzip \
        tar \
        unrar-free \
        xvfb \
        python3 \
        python3-pip \
        python3-numpy \
        python3-lxml \
        python3-shapely \
        python3-matplotlib \
        libxi6 \
        libxrender1 \
        libxrandr2 \
        libxinerama1 \
        libxcursor1 \
        libxcomposite1 \
        libxdamage1 \
        libxtst6 \
        libglib2.0-0 \
        libsm6 \
        libice6 \
        libgl1 \
        libgl1-mesa-dri \
        libegl1 \
        libxkbcommon0 \
        libxxf86vm1 \
        mesa-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# cascadio (OpenCASCADE) reads STEP/IGES and trimesh reads 3MF for
# scripts/convert_mesh.py - neither goes through Blender. networkx is needed
# by trimesh's 3MF loader; numpy and lxml come from the apt packages above.
# ifcopenshell is used by scripts/ifc_metadata.py to export IFC property sets
# (psets, quantities, spatial tree) to <name>_ifc.json next to the GLB.
RUN pip3 install --no-cache-dir --break-system-packages triangle cascadio trimesh networkx ifcopenshell

ARG BLENDER_SERIES=4.4
ARG BLENDER_VERSION=4.4.3
RUN curl -fsSL "https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}-linux-x64.tar.xz" -o /tmp/blender.tar.xz \
    && mkdir -p /opt/blender \
    && tar -xJf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 \
    && rm /tmp/blender.tar.xz \
    && ln -s /opt/blender/blender /usr/local/bin/blender

# gltfpack (meshoptimizer) re-compresses converted GLBs with Meshopt and
# KTX2/Basis textures and writes the lightweight preview used for progressive
# loading - see worker/optimize.py. A single static binary with its own
# Basis encoder; WORKER_OPTIMIZE=false turns the step off.
ARG GLTFPACK_VERSION=1.2
RUN curl -fsSL "https://github.com/zeux/meshoptimizer/releases/download/v${GLTFPACK_VERSION}/gltfpack-ubuntu.zip" -o /tmp/gltfpack.zip \
    && unzip -q /tmp/gltfpack.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/gltfpack \
    && rm /tmp/gltfpack.zip \
    && gltfpack -v

# Force Mesa's software rasterizer instead of probing for a (nonexistent)
# GPU device - without this, Blender's EEVEE either fails to get a GL
# context or hangs trying to find hardware acceleration that isn't there.
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV GALLIUM_DRIVER=llvmpipe

# Point clouds -> streamed 3D Tiles (worker/pointcloud.py): py3dtiles builds
# the tileset, laspy+lazrs reads LAZ without LAStools, pye57 reads E57. Kept
# after Blender so adding it did not invalidate the cached Blender layers.
RUN pip3 install --no-cache-dir --break-system-packages "py3dtiles[las]" "laspy[lazrs]" pye57 \
    && py3dtiles --help > /dev/null

# Point clouds -> Potree 2 (worker/pointcloud.py's default when it is here):
# PotreeConverter writes an octree in three files (metadata.json,
# hierarchy.bin, octree.bin) that the viewer reads node by node with HTTP
# range requests, keeping intensity and classification. There is no Linux
# release binary, so it is built from source; the compiler goes again
# afterwards and only the TBB runtime stays. CMAKE_POLICY_VERSION_MINIMUM
# lets newer CMake (4.x) configure its bundled laszip/brotli.
ARG POTREECONVERTER_VERSION=2.1.1
#
# PotreeConverter builds its bundled LASzip (3.4.1) as a shared library,
# liblaszip.so, next to the binary and finds it through a RUNPATH into the
# build directory - which is removed. So the library is installed to
# /usr/local/lib as well (ldconfig): the version the converter was compiled
# against, not Ubuntu's liblaszip. It finds its own folder from argv[0]
# against the working directory, so it is always run by its full path
# (`PotreeConverter --help` by name, from /, aborts: "cannot make canonical
# path [/PotreeConverter]").
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make libtbb-dev libtbb12 \
    && curl -fsSL "https://github.com/potree/PotreeConverter/archive/refs/tags/${POTREECONVERTER_VERSION}.tar.gz" | tar -xz -C /tmp \
    && cmake -S "/tmp/PotreeConverter-${POTREECONVERTER_VERSION}" -B /tmp/potree-build \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    && cmake --build /tmp/potree-build -j"$(nproc)" \
    && install -m 755 /tmp/potree-build/PotreeConverter /usr/local/bin/PotreeConverter \
    && install -m 644 /tmp/potree-build/liblaszip.so /usr/local/lib/liblaszip.so \
    && ldconfig \
    && rm -rf /tmp/PotreeConverter-* /tmp/potree-build \
    && apt-get purge -y cmake g++ make libtbb-dev \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/local/bin/PotreeConverter --help > /dev/null

# Khronos glTF-Validator checks every GLB/glTF before optimization and
# writes validation.json (worker/validate.py). A single native binary; kept
# after PotreeConverter so adding it did not invalidate the cached layers.
ARG GLTF_VALIDATOR_VERSION=2.0.0-dev.3.10
RUN curl -fsSL "https://github.com/KhronosGroup/glTF-Validator/releases/download/${GLTF_VALIDATOR_VERSION}/gltf_validator-${GLTF_VALIDATOR_VERSION}-linux64.tar.xz" -o /tmp/gltf_validator.tar.xz \
    && tar -xJf /tmp/gltf_validator.tar.xz -C /usr/local/bin gltf_validator \
    && chmod +x /usr/local/bin/gltf_validator \
    && rm /tmp/gltf_validator.tar.xz \
    && { gltf_validator --help 2>&1 || true; } | grep -q "glTF 2.0 Validator"

# Gaussian splats -> .rad (see the spark-build-lod stage at the top). Kept
# after the validator so adding it did not invalidate the cached layers.
COPY --from=spark-build-lod /usr/local/bin/build-lod /usr/local/bin/build-lod
RUN { build-lod 2>&1 || true; } | grep -q "Usage: build-lod"

# Runtime defaults that do not depend on the code.
ENV SPATH=/app
ENV BLENDER_BIN=blender
ENV WORKER_JOBS_DIR=/data/jobs
ENV WORKER_PORT=8080
# Same defaults scripts/.env.example documents - render_thumbnails.py falls back to
# these itself when unset, but setting them explicitly here is one less
# thing to go wrong now that scripts/.env doesn't ship in this image.
ENV RENDER_RESOLUTION=1024x1024x16
ENV RENDER_SAMPLES=20

WORKDIR /app
