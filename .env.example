# Copy to .env (git-ignored) and fill in. Two independent parts:
#
#  - WORKER_* / VIEWER_*: the server, read by docker compose (.env next to
#    docker-compose.yml). See docs/publishing.md, "1. Server".
#  - MOBILE_*: the Android release build, read by
#    scripts/build-android-release.sh on the build machine. See
#    docs/publishing.md, "2. Android app".
#
# Leaving a line out (or empty, where noted) means the default in
# docker-compose.yml / rollup.config.js.

# ============================================================================
# Server - must set before publishing
# ============================================================================

WORKER_AUTH_MODE=required
WORKER_ADMIN_USER=admin
# Created or RESET to this password on every start of the worker.
WORKER_ADMIN_PASSWORD=
# 1 = only the bundled nginx in front; 2 = a host nginx / Cloudflare-terminating
# proxy in front of it (docker/host-nginx.example.conf).
WORKER_TRUSTED_PROXIES=1
# RevenueCat REST API v2: secret key (sk_...) with read-only Customers +
# Entitlements permissions, and the project id (proj...). worker/README.md.
WORKER_REVENUECAT_SECRET_KEY=
WORKER_REVENUECAT_PROJECT_ID=
# Never true in production: trusts the plan the app reports.
WORKER_APP_PLANS_UNVERIFIED=false

# ============================================================================
# Server - optional
# ============================================================================

# open | approval | closed
WORKER_AUTH_REGISTRATION=approval
# Session-signing key; empty = generated once into the worker-jobs volume.
WORKER_AUTH_SECRET=

# "Account approved" mail; off without WORKER_SMTP_HOST.
WORKER_SMTP_HOST=
# starttls | ssl | none; empty port = 587 (starttls) or 465 (ssl).
WORKER_SMTP_SECURITY=starttls
WORKER_SMTP_PORT=
WORKER_SMTP_USER=
WORKER_SMTP_PASSWORD=
WORKER_SMTP_FROM=
WORKER_PUBLIC_URL=

# Upload cap in bytes; keep client_max_body_size in docker/nginx.conf (and a
# host nginx) in step.
WORKER_MAX_UPLOAD_BYTES=104857600
WORKER_MAX_CONCURRENT_CONVERSIONS=2

# Free/Pro accounts and anonymous (per IP) uploads; 0 = unlimited.
WORKER_LIMIT_UPLOADS_PER_HOUR=20
WORKER_LIMIT_UPLOADS_PER_DAY=100
WORKER_LIMIT_STORAGE_MB=0
WORKER_LIMIT_MAX_MODELS=0
WORKER_LIMIT_CONCURRENT_JOBS=1

# Business (app users and accounts with Business linked).
WORKER_LIMIT_BUSINESS_UPLOADS_PER_HOUR=100
WORKER_LIMIT_BUSINESS_UPLOADS_PER_DAY=500
WORKER_LIMIT_BUSINESS_CONCURRENT_JOBS=3
# Empty = the account defaults above.
WORKER_LIMIT_BUSINESS_STORAGE_MB=
WORKER_LIMIT_BUSINESS_MAX_MODELS=

# Entitlement identifiers in RevenueCat, and how long a plan is cached (s).
WORKER_REVENUECAT_BUSINESS_ENTITLEMENT=business
WORKER_REVENUECAT_PRO_ENTITLEMENT=pro
WORKER_REVENUECAT_CACHE_SEC=600

# ============================================================================
# Android release build (scripts/build-android-release.sh)
# ============================================================================

# RevenueCat PUBLIC Google key (goog_...), never the sk_ secret key.
MOBILE_REVENUECAT_API_KEY=
# AdMob: the app id (with ~) and the two ad units (with /).
MOBILE_ADMOB_APP_ID=
MOBILE_ADMOB_BANNER_ID=
MOBILE_ADMOB_INTERSTITIAL_ID=
# GlitchTip project DSN for bug reports and crashes (docs/error-tracking.md).
MOBILE_GLITCHTIP_DSN=
# MOBILE_GLITCHTIP_ENVIRONMENT=app

# The repository the app talks to. Leave out for the default
# (https://viewer.thedworak.com); set it empty for an offline-only app.
# MOBILE_REMOTE_URL=https://viewer.thedworak.com

# Optional, defaults in rollup.config.js:
# MOBILE_REVENUECAT_OFFERING=default
# MOBILE_PRODUCT_PRO=explora_pro
# MOBILE_PRODUCT_BUSINESS=explora_business_monthly
# MOBILE_ADMOB_INTERSTITIAL_EVERY=3
# MOBILE_ADMOB_INTERSTITIAL_MIN_INTERVAL_SEC=180
# MOBILE_DEFAULT_MODEL=./examples/WolpaSynagogue-progressive.glb
# The script always builds with MOBILE_MONETIZATION_TESTING=false.
