# Copy to .env (git-ignored) and fill in: WORKER_* / VIEWER_*, the server,
# read by docker compose (.env next to docker-compose.yml). See
# docs/publishing.md, "1. Server".
#
# Leaving a line out (or empty, where noted) means the default in
# docker-compose.yml.

# ============================================================================
# Server - must set before publishing
# ============================================================================

WORKER_AUTH_MODE=required
WORKER_ADMIN_USER=admin
# Created or RESET to this password on every start of the worker.
WORKER_ADMIN_PASSWORD=
# 1 = only the bundled nginx in front; 2 = a host nginx / Cloudflare-terminating
# proxy in front of it (docker/host-nginx.example.conf).
WORKER_TRUSTED_PROXIES=1
# Cloudflare: API token with Zone > Cache Purge and the zone id - the worker
# purges deleted models and re-rendered thumbnails. WORKER_PUBLIC_HOSTS: the
# viewer hostnames, comma-separated (each caches /files/ separately).
CF_API_TOKEN=
CF_ZONE_ID=
WORKER_PUBLIC_HOSTS=

# ============================================================================
# Server - optional
# ============================================================================

# open | approval | closed
WORKER_AUTH_REGISTRATION=approval
# Session-signing key; empty = generated once into the worker-jobs volume.
WORKER_AUTH_SECRET=

# "Account approved" mail; off without WORKER_SMTP_HOST.
WORKER_SMTP_HOST=
# starttls | ssl | none; empty port = 587 (starttls) or 465 (ssl).
WORKER_SMTP_SECURITY=starttls
WORKER_SMTP_PORT=
WORKER_SMTP_USER=
WORKER_SMTP_PASSWORD=
WORKER_SMTP_FROM=
WORKER_PUBLIC_URL=

# Reported models (worker/reports.py): mailed to these addresses
# (comma-separated, needs the SMTP settings above) and listed in /exadmin/,
# Reports. A model reported by this many people is hidden from others until
# an admin decides; 0 = never hidden automatically.
WORKER_REPORTS_EMAIL=
WORKER_REPORT_HIDE_THRESHOLD=3

# Upload cap in bytes; keep client_max_body_size in docker/nginx.conf (and a
# host nginx) in step.
WORKER_MAX_UPLOAD_BYTES=314572800
WORKER_MAX_CONCURRENT_CONVERSIONS=2

# Accounts and anonymous (per IP) uploads; 0 = unlimited.
WORKER_LIMIT_UPLOADS_PER_HOUR=20
WORKER_LIMIT_UPLOADS_PER_DAY=100
WORKER_LIMIT_STORAGE_MB=0
WORKER_LIMIT_MAX_MODELS=0
WORKER_LIMIT_CONCURRENT_JOBS=1

# Business (accounts with the Business plan).
WORKER_LIMIT_BUSINESS_UPLOADS_PER_HOUR=100
WORKER_LIMIT_BUSINESS_UPLOADS_PER_DAY=500
WORKER_LIMIT_BUSINESS_CONCURRENT_JOBS=3
# Empty = the account defaults above.
WORKER_LIMIT_BUSINESS_STORAGE_MB=
WORKER_LIMIT_BUSINESS_MAX_MODELS=

# ---------------------------------------------------------------------------
# AI assistance (worker/ai.py, docs/ai.md) - read by the WORKER, not by the
# viewer or app builds: rebuild and restart the worker after changing them.
# ---------------------------------------------------------------------------
WORKER_AI_ENABLED=false
# The key as it is (sk-ant-..., only letters, digits, - and _): no quotes
# or escaping needed.
ANTHROPIC_API_KEY=
# business (default): Business/Enterprise accounts, the app's Business
# subscribers (verified by the app store purchase check) and admins. users = anyone logged
# in, all = everyone (e.g. for testing).
WORKER_AI_ACCESS=business
WORKER_AI_REQUESTS_PER_HOUR=30
# Empty = claude-opus-5-5; empty FEATURES = validation,ifc-query,variants.
WORKER_AI_MODEL=
WORKER_AI_FEATURES=

# Place search for the viewer's suggested scene (worker/geonames.py): the
# GeoNames dump the worker image downloads (build arg GEONAMES_DATASET).
# Empty turns it off; other files (e.g. a country's PL.txt) comma-separated.
# WORKER_GEONAMES=/app/geonames/places.txt

# Point cloud classification before tiling (worker/classify.py): off | auto | always.
WORKER_POINTCLOUD_CLASSIFY=off
WORKER_POINTCLOUD_CLASSIFIER=geometric
WORKER_POINTCLOUD_CLASSIFIER_CMD=
