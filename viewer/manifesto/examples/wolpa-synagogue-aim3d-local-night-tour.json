              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "The Torah ark (Aron ha-Kodesh) stands on the east wall, facing Jerusalem, and is the focal point of the prayer hall.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Aron ha-Kodesz, szafa ołtarzowa na zwoje Tory, stoi przy ścianie wschodniej, zwróconej ku Jerozolimie, i jest centralnym punktem sali modlitw.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Der Toraschrein (Aron ha-Kodesch) steht an der nach Jerusalem gerichteten Ostwand und ist der Blickpunkt des Betsaals.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
