              "created": "2026-09-30T00:00:00.000Z",
              "modified": "2026-09-30T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "Above the walls of the hall the wooden dome begins. Each tier is set back from the one below and edged by a small gallery.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Nad ścianami sali zaczyna się drewniana kopuła. Każda kondygnacja jest cofnięta względem niższej i obwiedziona niewielką galerią.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Über den Wänden des Saals beginnt die Holzkuppel. Jede Stufe springt gegenüber der unteren zurück und wird von einer kleinen Galerie gesäumt.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
