              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "First tier of the dome"
                ],
                "pl": [
                  "Pierwsza kondygnacja kopuły"
                ],
                "de": [
                  "Erste Stufe der Kuppel"
                ]
