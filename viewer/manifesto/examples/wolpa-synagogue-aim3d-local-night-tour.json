              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "The entrance side of the building. The chevron ornament sits on the building's main axis, above the vestibule.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Strona wejściowa budynku. Ornament w jodełkę leży na głównej osi budowli, nad przedsionkiem.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Die Eingangsseite des Gebäudes. Das Fischgrätornament liegt auf der Hauptachse über dem Vorraum.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
