            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-05-windows",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Stained-glass windows"
                ],
                "pl": [
                  "Witraże"
                ],
                "de": [
                  "Buntglasfenster"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "The side walls and the back wall have stained-glass windows. Their colours glow slightly on their own (an emissive texture), so they read even in the shade.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Ściany boczne i tylna mają witrażowe okna. Ich kolory lekko świecą same z siebie (tekstura emisyjna), więc są czytelne nawet w cieniu.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Die Seitenwände und die Rückwand haben Buntglasfenster. Ihre Farben leuchten leicht von selbst (eine emissive Textur) und bleiben so auch im Schatten lesbar.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": {
                  "id": "./examples/tempietto/Tempietto.glb/scene",
                  "type": "Scene"
