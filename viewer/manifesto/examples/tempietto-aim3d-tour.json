            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-07-skylight",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Skylight"
                ],
                "pl": [
                  "Świetlik"
                ],
                "de": [
                  "Oberlicht"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "A glazed skylight in the roof lights the glass sphere from above. With the roof hidden (hierarchy panel) the cella can be looked into from here.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Przeszklony świetlik w dachu oświetla szklaną kulę od góry. Po ukryciu dachu (panel hierarchii) można stąd zajrzeć do celi.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Ein verglastes Oberlicht im Dach beleuchtet die Glaskugel von oben. Wird das Dach ausgeblendet (Hierarchie), lässt sich von hier in die Cella sehen.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
