                  "fov": 45
                }
              }
            },
            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-03-drum",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Fallen drum"
                ],
                "pl": [
                  "Upadły bęben"
                ],
                "de": [
                  "Herabgefallene Trommel"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "A column drum lies at the foot of the podium, where it fell when the column broke. Pieces like this one help to reconstruct the height of the missing shaft.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "U stóp podium leży bęben kolumny, który spadł, gdy kolumna się złamała. Takie fragmenty pomagają odtworzyć wysokość brakującego trzonu.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Am Fuß des Podiums liegt eine Säulentrommel, die beim Bruch der Säule herabfiel. Solche Fragmente helfen, die Höhe des fehlenden Schafts zu rekonstruieren.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": {
                  "id": "./examples/tempietto/Tempietto.glb/scene",
