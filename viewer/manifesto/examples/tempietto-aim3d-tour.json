            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-04-interior",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Glass sphere in the cella"
                ],
                "pl": [
                  "Szklana kula w celi"
                ],
                "de": [
                  "Glaskugel in der Cella"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "Inside the cella a glass sphere rests on a pedestal. In the glTF file it uses real transmission and refraction (KHR_materials_transmission), so the room behind it is seen through the glass.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Wewnątrz celi na postumencie spoczywa szklana kula. W pliku glTF ma prawdziwą transmisję i załamanie światła (KHR_materials_transmission), więc wnętrze za nią widać przez szkło.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "In der Cella ruht eine Glaskugel auf einem Sockel. In der glTF-Datei nutzt sie echte Transmission und Lichtbrechung (KHR_materials_transmission), sodass der Raum dahinter durch das Glas sichtbar ist.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": {
                  "id": "./examples/tempietto/Tempietto.glb/scene",
                  "type": "Scene"
                },
                "selector": [
