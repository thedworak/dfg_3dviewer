            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-01-podium",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Podium and steps"
                ],
                "pl": [
                  "Podium i schody"
                ],
                "de": [
                  "Podium und Stufen"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "The temple stands on a raised podium of stone blocks, reached by three steps at the front. The podium lifts the cella above the ground and gives the small building its monumental presence.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Świątynia stoi na podwyższonym podium z kamiennych bloków, na które prowadzą trzy stopnie od frontu. Podium unosi celę ponad teren i nadaje małej budowli monumentalny charakter.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Der Tempel steht auf einem erhöhten Podium aus Steinblöcken, zu dem vorne drei Stufen hinaufführen. Das Podium hebt die Cella über das Gelände und verleiht dem kleinen Bau eine monumentale Wirkung.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": {
                  "id": "./examples/tempietto/Tempietto.glb/scene",
                  "type": "Scene"
                },
                "selector": [
