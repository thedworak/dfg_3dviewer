                    8.5
                  ],
                  "target": [
                    0,
                    0.8,
                    1.5
                  ],
                  "fov": 45
                }
              }
            },
            {
              "id": "./examples/tempietto/Tempietto.glb/scene/annotation/tour-02-colonnade",
              "type": "Annotation",
              "motivation": [
                "commenting"
              ],
              "label": {
                "en": [
                  "Colonnade and the broken column"
                ],
                "pl": [
                  "Kolumnada i złamana kolumna"
                ],
                "de": [
                  "Säulenhalle und die gebrochene Säule"
                ]
              },
              "created": "2026-10-07T00:00:00.000Z",
              "modified": "2026-10-07T00:00:00.000Z",
              "body": {
                "type": "Choice",
                "items": [
                  {
                    "type": "TextualBody",
                    "value": "Four columns carry the entablature of the portico. Only the lower drums of the fourth column survive; its upper part is a reconstruction based on the three complete columns.",
                    "format": "text/plain",
                    "language": [
                      "en"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Cztery kolumny dźwigają belkowanie portyku. Z czwartej kolumny zachowały się tylko dolne bębny; jej górna część jest rekonstrukcją na podstawie trzech kompletnych kolumn.",
                    "format": "text/plain",
                    "language": [
                      "pl"
                    ]
                  },
                  {
                    "type": "TextualBody",
                    "value": "Vier Säulen tragen das Gebälk der Vorhalle. Von der vierten Säule sind nur die unteren Trommeln erhalten; ihr oberer Teil ist eine Rekonstruktion nach den drei vollständigen Säulen.",
                    "format": "text/plain",
                    "language": [
                      "de"
                    ]
                  }
                ]
              },
              "target": {
                "type": "SpecificResource",
                "source": {
                  "id": "./examples/tempietto/Tempietto.glb/scene",
                  "type": "Scene"
                },
                "selector": [
                  {
                    "type": "PointSelector",
                    "x": 1.5,
                    "y": 1.85,
                    "z": 1.88
                  }
                ]
              },
              "AIM3DViewer": {
                "groupId": "",
                "key": "",
                "object": "",
                "targetId": "m0:root",
                "point": [
                  1.5,
